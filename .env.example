# Supabase — obtén estos en supabase.com > proyecto > Settings > API
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase service role key — misma pantalla, sección "service_role" (NO la anon key)
# Sin prefijo VITE_: tiene acceso total a la base de datos, se usa solo en
# api/invite-member.js y api/report.js. Nunca la expongas en el frontend ni la loguees.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Anthropic — obtén tu key en console.anthropic.com
# Sin prefijo VITE_: esta clave solo debe usarse desde el backend (api/claude.js), nunca en el bundle del navegador
ANTHROPIC_API_KEY=sk-ant-tu_key_aqui

# Stripe — obtén tu key en dashboard.stripe.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_tu_key_aqui

# App
VITE_APP_URL=http://localhost:5173
